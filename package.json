{
  "name": "mangaverse",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MangaVerse — Web3-powered manga creation & reading platform",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "dev:api": "tsx watch src/api/server.ts",
    "build": "vite build",
    "build:development": "vite build --mode development",
    "build:staging": "vite build --mode staging",
    "build:production": "vite build --mode production",
    "preview": "vite preview",
    "start": "tsx src/api/server.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "tsc --noEmit",
    "check-single-letter-vars": "node scripts/check-single-letter-vars.mjs",
    "check-import-order": "node scripts/check-import-order.mjs",
    "check-comments": "node scripts/check-comments.mjs",
    "check-test-stubs": "node scripts/check-test-stubs.mjs",
    "check-no-verify": "node scripts/detect-no-verify.mjs",
    "run-quality-gate": "node scripts/run-quality-gate.mjs",
    "commands": "node scripts/show-commands.mjs",
    "check-security": "pnpm audit --audit-level=high",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm lint && pnpm check-test-stubs && pnpm check-single-letter-vars && pnpm check-import-order && pnpm check-comments && pnpm check-types && pnpm test:ci",
    "clean": "node -e \"const f=require('fs');['node_modules','dist','coverage'].forEach(d=>f.rmSync(d,{recursive:true,force:true}))\""
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write",
    "src/**/*.{js,ts,tsx,jsx}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "dependencies": {
    "express": "^4.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.39.0",
    "eslint-import-resolver-typescript": "^3.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "eslint-config-prettier": "^9.1.0",
    "espree": "^11.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-organize-imports": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
